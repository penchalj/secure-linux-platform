# Garage config for the Secure Linux Platform cache (single node, no replication).
# Rendered by bootstrap-cache.sh into $SLP_SERVICES_DIR/garage/garage.toml with
# fresh secrets. The rendered file is NOT committed (contains secrets).
metadata_dir = "/var/lib/garage/meta"
data_dir     = "/var/lib/garage/data"
db_engine    = "sqlite"

replication_factor = 1

rpc_bind_addr   = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret      = "__RPC_SECRET__"

[s3_api]
s3_region     = "garage"
api_bind_addr = "[::]:3900"
root_domain   = ".s3.garage"

# Read-only HTTP for build consumers: buckets with website access enabled are
# served at http://<bucket>.web.garage:3902/<key>  (GET/HEAD only)
[s3_web]
bind_addr   = "[::]:3902"
root_domain = ".web.garage"
index       = "index.html"

[admin]
api_bind_addr = "[::]:3903"
admin_token   = "__ADMIN_TOKEN__"
metrics_token = "__METRICS_TOKEN__"
